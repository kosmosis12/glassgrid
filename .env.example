# Cerebras API key — get one at https://cloud.cerebras.ai
# This stays SERVER-SIDE only. It is never shipped to the browser.
CEREBRAS_API_KEY=csk-your-key-here

# Cerebras Gemma 4 multimodal model id.
# Verified against https://inference-docs.cerebras.ai/capabilities/image-inputs
# (image support is only available on gemma-4-31b).
CEREBRAS_MODEL=gemma-4-31b

# Cerebras OpenAI-compatible base URL.
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Port the proxy server listens on (the Vite dev client proxies /api here).
PORT=8787
